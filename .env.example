APP_ENV=development
PORT=8000

# Anthropic (Claude) — lectura de tacómetros por visión.
# La key real va SOLO en .env.local (no se commitea).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_S=30
ANTHROPIC_MAX_RETRIES=3

# Token compartido entre NestJS y pyservices (header X-Internal-Token).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SHARED_TOKEN=
