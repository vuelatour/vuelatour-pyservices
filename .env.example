APP_ENV=development
PORT=8000

# Anthropic (Claude) — lectura de tacómetros por visión y extracción de tickets/PDF.
# La key real va SOLO en .env.local (no se commitea).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_S=30
ANTHROPIC_MAX_RETRIES=3

# Token compartido entre NestJS y pyservices (header X-Internal-Token).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SHARED_TOKEN=
# Token de servicio para los routers de dramirez (header X-Service-Token).
# Puede ser el MISMO valor que INTERNAL_SHARED_TOKEN.
SERVICE_TOKEN=

# ===== FEL (PAC) — timbrado CFDI 4.0 =====
# Credenciales del Usuario de Timbrado FEL. Vacío = facturación deshabilitada.
FEL_USUARIO=
FEL_PASSWORD=
# WSDL: pruebas por defecto. Productivo: https://www.fel.mx/WSTimbrado33/WSCFDI33.svc?WSDL
FEL_WSDL_URL=https://app.fel.mx/WSTimbrado33Test/WSCFDI33.svc?WSDL
FEL_MODO=test
